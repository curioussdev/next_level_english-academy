# Supabase / PostgreSQL
# DATABASE_URL usa o pooler (pgbouncer, porta 6543) — para runtime da app.
# DIRECT_URL usa a conexão direta (porta 5432) — para migrations do Prisma.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# NextAuth (Auth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # gerar com: openssl rand -base64 32

# Login demo (contas fictícias do prisma/seed.ts) quando o banco não está
# acessível. Exige NODE_ENV!=='production' E esta flag — deixe "false"/vazio
# em qualquer ambiente que não seja a sua máquina de desenvolvimento local.
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"

# OAuth Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price IDs (modo "recurring") dos planos criados no Dashboard do Stripe
STRIPE_PRICE_BASIC=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PREMIUM=""

# Web Push (VAPID) — gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@nextlevel.pt"
# Mesma chave pública acima — precisa do prefixo NEXT_PUBLIC_ para chegar ao browser
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
